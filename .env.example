# ==============================================================================
# PyqVitAp — Environment Variables Template
# ==============================================================================
# Duplicate this file as `.env` and fill in your values for local development.
# Never commit your real `.env` file to version control.
# ==============================================================================

# Database
# MongoDB Atlas or local connection string
MONGODB_URI=""

# Application URL
# e.g., "http://localhost:3000" or "https://pyqvitap.vercel.app"
SERVER_URL=""

# Cloudinary Storage
# Used for storing and serving paper PDFs and thumbnail previews
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upstash Redis (Optional / Recommended for Rate Limiting)
# REST credentials for Upstash Redis used in request throttling
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Gemini AI (Optional / Recommended for Upload Auto-Tagging)
# Google Gemini API key for automated metadata detection on student uploads
GEMINI_API_KEY=""
